{
  "name": "listpro-mebel-desktop",
  "version": "0.2.0",
  "private": true,
  "description": "ListPro Mebel experimental held-strips Windows desktop application",
  "main": "main.cjs",
  "author": "ListPro",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "node ../desktop-demo/scripts/build.cjs",
    "test": "node --test tests/*.test.cjs ../desktop-demo/tests/*.test.cjs",
    "build:win:full": "electron-builder --win portable --x64 && node scripts/smoke-windows.cjs"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "ru.listpro.mebel",
    "productName": "ЛистПро Мебель",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "worker.cjs",
      "engine.cjs",
      "index.html",
      "ui.js",
      "style.css",
      "package.json",
      "table-import.js"
    ],
    "extraResources": [
      {
        "from": "../src",
        "to": "listpro-core/src",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../benchmarks/bazis-26-corrected.json",
        "to": "listpro-core/benchmarks/bazis-26-corrected.json"
      },
      {
        "from": "../benchmarks/held-strips/result.json",
        "to": "listpro-core/benchmarks/held-strips/result.json"
      },
      {
        "from": "../benchmarks/order-171/input.json",
        "to": "listpro-core/benchmarks/order-171/input.json"
      },
      {
        "from": "../benchmarks/order-171/result.json",
        "to": "listpro-core/benchmarks/order-171/result.json"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ListPro-Mebel-${version}-win-x64.${ext}"
    },
    "compression": "normal",
    "publish": null
  }
}

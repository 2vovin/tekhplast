{
  "name": "listpro-windows-demo",
  "version": "0.1.0",
  "private": true,
  "description": "ListPro offline Windows demo: two detailed sheets",
  "author": "ListPro",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "prepare:ui": "node scripts/prepare.cjs",
    "test": "node --test tests/*.test.cjs",
    "build:win": "node scripts/build.cjs"
  },
  "build": {
    "appId": "ru.listpro.demo",
    "productName": "ЛистПро Демо",
    "asar": true,
    "directories": {
      "output": "../desktop/dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "worker.cjs",
      "policy.cjs",
      "package.json",
      "renderer/**",
      "scripts/gui-smoke.cjs",
      "core/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ListPro-Demo-${version}-win-x64.${ext}"
    },
    "publish": null
  }
}
